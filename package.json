{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:assets": "node scripts/generate-og-image.js",
    "prebuild": "npm run generate:assets",
    "start": "ng serve",
    "build": "ng build",
    "package:aws": "python scripts/package-aws.py",
    "watch": "ng build --watch --configuration development",
